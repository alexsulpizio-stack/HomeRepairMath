# Leave blank to use Vercel's assigned production URL (localhost during local development).
# Set only after a custom domain is acquired and connected to this project.
NEXT_PUBLIC_SITE_URL=

# Optional Search Console HTML-tag verification token. Paste only the token value,
# not the full <meta> tag. Remove after verification only if Google no longer needs it.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Add only after AdSense approval and slot creation.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_CONTENT=

# Optional analytics. Do not add until the privacy/consent implementation is ready.
NEXT_PUBLIC_GA_ID=
